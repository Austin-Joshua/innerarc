{
  "expo": {
    "name": "Innerarc",
    "slug": "innerarc",
    "scheme": "innerarc",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-dev-client",
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Innerarc uses photos to log meals.",
          "cameraPermission": "Innerarc uses the camera to log meals."
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.innerarc.app"
    },
    "android": {
      "package": "com.innerarc.app",
      "permissions": [
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.WRITE_STEPS",
        "android.permission.health.WRITE_HEART_RATE",
        "android.permission.health.WRITE_SLEEP"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#F6F4F1",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png",
      "name": "Innerarc",
      "shortName": "Innerarc",
      "description": "Nutrition, training, and progress in one place.",
      "themeColor": "#3F63C4",
      "backgroundColor": "#F6F4F1",
      "output": "single",
      "lang": "en"
    }
  }
}
