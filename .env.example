# PostgreSQL (must match docker-compose.yml)
POSTGRES_USER=innerarc
POSTGRES_PASSWORD=innerarc
POSTGRES_DB=innerarc
POSTGRES_PORT=5432

# Backend
DATABASE_URL=postgresql+psycopg://innerarc:innerarc@localhost:5432/innerarc
OBJECT_STORAGE_PATH=../data/photos

# AI coach + plate vision (optional — disabled by default)
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Auth
JWT_SECRET=innerarc-dev-secret-change-me-32b+
JWT_EXPIRE_MINUTES=10080

# Classifier (path relative to backend/)
CLASSIFIER_CHECKPOINT=../ml/checkpoints/best.pt
# True = /food/classify returns a random seeded dish instead of loading the checkpoint.
# Flip to false only after training finishes and ml/reports/test_metrics.json is checked.
CLASSIFIER_STUB_MODE=true

# Progress pose (MediaPipe Tasks Pose Landmarker)
POSE_LANDMARKER_MODEL=../ml/checkpoints/pose_landmarker_lite.task

# Photo encryption at rest (Fernet). Required for new meal/progress uploads.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PHOTO_ENCRYPTION_KEY=

# CORS — Expo web / Metro defaults
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
